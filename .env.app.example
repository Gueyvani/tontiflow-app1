# ==============================================================================
# TontiFlow - Variables pour la stack applicative containerisee (decision R12)
# Copier ce fichier sous le nom '.env.app' et renseigner des valeurs reelles.
# Distinct du .env de docker-compose.yml (PostgreSQL de developpement local) :
# cette stack utilise son propre PostgreSQL applicatif isole.
#
# Usage :
#   cp .env.app.example .env.app
#   docker compose --env-file .env.app -f docker-compose.app.yml up -d --build
# ==============================================================================

# PostgreSQL applicatif (isole, distinct de tontiflow-postgres) - AUCUNE valeur
# par defaut n'est fournie par docker-compose.app.yml : ces deux variables sont
# obligatoires (le compose echoue explicitement si elles sont absentes).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Eureka (discovery-service) - HTTP Basic service-a-service. Obligatoires.
EUREKA_USERNAME=eureka
EUREKA_PASSWORD=changeme

# Config Server (config-service) - HTTP Basic. Obligatoires. Rappel (audit R12) :
# ce service n'est actuellement consomme par aucun autre service du monorepo.
CONFIG_SERVER_USERNAME=config
CONFIG_SERVER_PASSWORD=changeme

# Port hote publie pour api-gateway (seul port publie de toute la stack).
# 18080 par defaut : le port 8080 s'est revele deja occupe par un processus
# tiers sans rapport lors de la validation R12 sur cette machine - ajustez
# selon votre propre environnement.
GATEWAY_HOST_PORT=18080
