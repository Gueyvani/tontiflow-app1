# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Database Names
DB_USERS=db_users
DB_TONTINE=db_tontine
DB_FINANCE=db_finance
DB_CREDIT=db_credit
DB_NOTIFICATION=db_notification