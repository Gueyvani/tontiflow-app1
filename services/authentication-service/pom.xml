<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.tontiflow</groupId>
		<artifactId>services</artifactId>
		<version>1.0.0-SNAPSHOT</version>
	</parent>

	<artifactId>authentication-service</artifactId>
	<packaging>jar</packaging>

	<name>TontiFlow :: Services :: Authentication Service</name>

	<!-- TICKET-3 (test uniquement) : le BOM Spring Boot 3.3.13 gere Testcontainers 1.19.8 (docker-java
	     3.3.6), dont les requetes sont rejetees (HTTP 400) par Docker Engine 29 / Docker Desktop
	     recent. Surcharge limitee a ce module ; aucune incidence sur le code de production. -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers-bom</artifactId>
				<version>1.21.4</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- TICKET-3 : preuve de contention de verrou sur un vrai PostgreSQL (postgres:16-alpine,
		     identique a la production). Versions gerees par le BOM Spring Boot ; test uniquement. -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Contrat de securite partage (UserContext, JwtClaimNames, BearerTokenExtractor) -->
		<dependency>
			<groupId>com.tontiflow</groupId>
			<artifactId>security-common</artifactId>
		</dependency>

		<!-- Declaration explicite (deja transitive via security-common) : utilisee
		     directement par AccessTokenService pour signer/valider les JWT RS256. -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- Client Eureka (requis par la config eureka.client.* d'application.yml) -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
		</dependency>

		<!-- Driver PostgreSQL & Flyway (requis par application.yml) -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!-- TICKET-3 : les tests PostgreSQL/Testcontainers (*PostgresIntegrationTest) exigent Docker.
			     Ils sont exclus du build standard (./mvnw clean verify fonctionne sans Docker) et ne
			     sont executes que via le profil "postgres-integration" (voir ci-dessous). -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>**/*PostgresIntegrationTest.java</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Validation PostgreSQL reelle (Testcontainers, postgres:16-alpine, Flyway V1..V5) :
		         ./mvnw -pl services/authentication-service -Ppostgres-integration test
		     Ce profil retire l'exclusion : les tests PostgreSQL sont alors executes en plus des
		     autres tests du module. Docker est requis ; sans Docker ils ECHOUENT (jamais ignores). -->
		<profile>
			<id>postgres-integration</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<excludes combine.self="override"/>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
